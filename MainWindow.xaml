<Window x:Class="WpfPractice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPractice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="CounterText" 
                    Text="Button clicked: 0 times" 
                    FontSize="18" 
                    Margin="0,0,0,15" 
                    HorizontalAlignment="Center"/>
        <Button Content="Click Me" 
                    Width="120" 
                    Height="35" 
                    FontSize="14"
                    Click="OnButtonClick"/>
        <TextBlock 
                Text="Enter Your Name: "
                Margin="0, 0, 0, 5"/>
        <TextBox 
                Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                Margin="0,0,0,15"
                Padding="4"/>
        <Button Content="Greet Admin"
                Command="{Binding GreetCommand}"
                CommandParameter="Administrator"
                Padding="8,4"/>
    </StackPanel>
</Window>
